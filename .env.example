# GB SafeData 인증 정보 — 커밋 금지 (.gitignore로 차단됨)
#
# 발급 절차와 리드타임은 ../jxkr2026-datasets/docs/external-portals.md 참고.
# 키가 없는 커넥터는 자동으로 unavailable 상태가 되며, 서버는 그 사실을
# 숨기지 않고 degraded로 응답한다. 전부 채워야 하는 것은 아니다.

# ── 필수: 공공데이터포털 (data.go.kr) ────────────────────────
# 이 키 하나로 검증된 11종 API가 동작한다.
# 마이페이지 > 인증키 발급현황. 신청 후 최대 1시간 뒤 활성화
GBSAFE_DATA_GO_KR_SERVICE_KEY=
# 일부 SDK가 요구하는 URL 인코딩본 (선택)
GBSAFE_DATA_GO_KR_SERVICE_KEY_ENCODED=

# ── 선택: 기상청 API허브 (apihub.kma.go.kr) ──────────────────
# 레이더 합성·AWS 1분자료. data.go.kr 키와 별개, 가입 즉시 발급
GBSAFE_KMA_APIHUB_AUTH_KEY=

# ── 선택: 한강홍수통제소 (hrfco.go.kr) ───────────────────────
# 실시간 수위·유량·홍수특보. 이메일 승인 클릭 1회 필요
GBSAFE_HRFCO_SERVICE_KEY=

# ── 선택: 재난안전데이터 공유플랫폼 (safetydata.go.kr) ────────
GBSAFE_SAFETYDATA_SERVICE_KEY=

# ── 선택: 생활안전지도 (safemap.go.kr) ───────────────────────
# 발급 시 등록한 도메인에서만 호출 가능하며 이후 변경 불가
GBSAFE_SAFEMAP_API_KEY=

# ── 선택: ITS 국가교통정보센터 (its.go.kr) ───────────────────
# 실시간 돌발·통제정보
GBSAFE_ITS_API_KEY=

# ── 선택: VWorld (vworld.kr) ─────────────────────────────────
GBSAFE_VWORLD_API_KEY=

# ── 선택: SGIS 오픈플랫폼 (sgisapi.mods.go.kr) ───────────────
GBSAFE_SGIS_CONSUMER_KEY=
GBSAFE_SGIS_CONSUMER_SECRET=

# ── 런타임 설정 ──────────────────────────────────────────────
# 스냅샷·캐시 저장 위치
GBSAFE_STORE_DIR=var/gbsafe
# 원천 API 호출 캐시 TTL 배수 (1.0 = 데이터셋 갱신주기 그대로)
GBSAFE_CACHE_TTL_FACTOR=1.0
# 실데이터 대신 저장된 스냅샷만 사용 (오프라인 시연·훈련용)
GBSAFE_OFFLINE=false
